                                                  DisplayMemberPath="Name"
                                                  SelectedValuePath="Id"
                                                  Tag="-- 选择 Worker 模板 --"
                                                  SelectionChanged="DeployConfig_Changed"/>
                                    </StackPanel>
                                </Grid>
                               
                                <!-- 变量配置面板 -->
                                <Border x:Name="VariablesConfigPanel"
                                        Background="{DynamicResource BgInput}"
                                        CornerRadius="8"
                                        Padding="16"
                                        Margin="0,16,0,0"
                                        Visibility="Collapsed"
                                        MaxHeight="300">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel>
                                            <TextBlock Text="变量配置"
                                                       Foreground="{DynamicResource TextPrimary}"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,0,12"/>
                                            <ItemsControl x:Name="DeployVariablesList"/>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>
                               
                                <!-- 部署矩阵预览区域 - 固定高度 -->
                                <Border x:Name="MatrixPreviewPanel"
                                        Background="{DynamicResource BgInput}"
                                        CornerRadius="8"
                                        Padding="16"
                                        Margin="0,16,0,0"
                                        Visibility="Collapsed"
                                        Height="400">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                       
                                        <!-- 顶部标题 -->
                                        <Grid Grid.Row="0" Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="部署矩阵预览"
                                                           Foreground="{DynamicResource TextPrimary}"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock x:Name="MatrixCountText"
                                                           Foreground="{DynamicResource TextSecondary}"
                                                           FontSize="12"
                                                           Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <Button Content="全选"
                                                        Style="{StaticResource SecondaryButton}"
                                                        Margin="0,0,8,0"
                                                        Click="SelectAllMatrix_Click"/>
                                                <Button Content="取消全选"
                                                        Style="{StaticResource SecondaryButton}"
                                                        Click="SelectNoneMatrix_Click"/>
                                            </StackPanel>
                                        </Grid>
                                       
                                        <!-- 矩阵内容 - 固定高度可滚动 -->
                                        <ScrollViewer Grid.Row="1"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      Margin="0,0,0,12">
                                            <WrapPanel x:Name="MatrixItemsPanel"/>
                                        </ScrollViewer>
                                       
                                        <!-- 开始部署按钮 - 红色长条，保持不变 -->
                                        <Button Grid.Row="2"
                                                Content="🚀 开始批量部署"
                                                Style="{StaticResource DangerButton}"
                                                HorizontalAlignment="Stretch"
                                                Padding="16"
                                                FontSize="14"
                                                FontWeight="Bold"
                                                Click="StartMatrixDeploy_Click"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                       
                        <!-- 实时日志面板 -->
                        <Border Style="{StaticResource CardStyle}"
                                Margin="0,16,0,0"
                                Height="400">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                               
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <TextBlock Text="📋 实时日志"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   FontWeight="SemiBold"
                                                   FontSize="16"/>
                                        <Border Background="{DynamicResource Primary}"
        Width="22"
        Height="22"
        CornerRadius="11"
        Margin="8,0,0,0">
    <TextBlock x:Name="LogCountText"
               Text="0"
               Foreground="White"
               FontSize="10"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"/>
</Border>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="💾 导出"
                                            Style="{StaticResource SecondaryButton}"
                                            Margin="0,0,8,0"
                                            Click="ExportLogs_Click"/>
                                    <Button Grid.Column="2"
                                            Content="🗑️ 清空"
                                            Style="{StaticResource SecondaryButton}"
                                            Click="ClearLogs_Click"/>
                                </Grid>
                                <!-- 日志筛选按钮 -->
<StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
    <RadioButton GroupName="LogFilterGroup"
                 Content="全部"
                 Style="{StaticResource LogFilterButton}"
                 Click="FilterLogs_Click"
                 Tag="all"
                 IsChecked="True"/>
    <RadioButton GroupName="LogFilterGroup"
                 Content="信息"
                 Style="{StaticResource LogFilterButton}"
                 Margin="8,0,0,0"
                 Click="FilterLogs_Click"
                 Tag="info"/>
    <RadioButton GroupName="LogFilterGroup"
                 Content="成功"
                 Style="{StaticResource LogFilterButton}"
                 Margin="8,0,0,0"
                 Click="FilterLogs_Click"
                 Tag="success"/>
    <RadioButton GroupName="LogFilterGroup"
                 Content="警告"
                 Style="{StaticResource LogFilterButton}"
                 Margin="8,0,0,0"
                 Click="FilterLogs_Click"
                 Tag="warning"/>
    <RadioButton GroupName="LogFilterGroup"
                 Content="错误"
                 Style="{StaticResource LogFilterButton}"
                 Margin="8,0,0,0"
                 Click="FilterLogs_Click"
                 Tag="error"/>
</StackPanel>
                               
                                <Border Grid.Row="2"
                                        Background="{DynamicResource BgInput}"
                                        BorderBrush="{DynamicResource Border}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <Grid>
                                        <ScrollViewer x:Name="LogsScrollViewer"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      Margin="8">
                                            <ItemsControl x:Name="LogsItemsControl"
                                                          ItemTemplate="{StaticResource LogEntryTemplate}"/>
                                        </ScrollViewer>
                                        <TextBlock x:Name="EmptyLogText"
                                                   Text="暂无日志消息..."
                                                   Foreground="{DynamicResource TextMuted}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
       
        <!-- 状态栏 -->
        <Border Grid.Row="4"
                Background="{DynamicResource BgCard}"
                BorderBrush="{DynamicResource Border}"
                BorderThickness="0,1,0,0"
                Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
               
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8"
                             Fill="{Binding StatusColor}"
                             Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding StatusText}"
                               Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>
               
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal">
                    <Button x:Name="ThemeToggleBtn"
                            Content="{Binding ThemeButtonContent}"
                            Style="{StaticResource SecondaryButton}"
                            Margin="0,0,8,0"
                            Click="ToggleTheme_Click"
                            ToolTip="切换主题"/>
                   
                    <Button Content="📤 导出"
                            Style="{StaticResource SecondaryButton}"
                            Margin="0,0,8,0"
                            Click="Export_Click"/>
                    <Button Content="📥 导入"
                            Style="{StaticResource SecondaryButton}"
                            Margin="0,0,8,0"
                            Click="Import_Click"/>
                    <Button Content="🗑️ 重置"
                            Style="{StaticResource DangerButton}"
                            Margin="0,0,8,0"
                            Click="Reset_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>