<Window x:Class="CFDeployer.Dialogs.ProxyConfigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="代理配置" 
        Height="420" Width="550"
        Background="{DynamicResource BgDark}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    
    <Window.Resources>
    <!-- 复用 App.xaml 中已定义的样式，不再重复定义颜色资源 -->
    
    <Style x:Key="DialogTextBox" TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
        <Setter Property="MinHeight" Value="45"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Disabled"/>
    </Style>
    
    <Style x:Key="DialogPasswordBox" TargetType="PasswordBox" BasedOn="{StaticResource ModernPasswordBox}">
        <Setter Property="MinHeight" Value="45"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    
    <Style x:Key="DialogSecondaryButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="Width" Value="45"/>
        <Setter Property="Height" Value="45"/>
    </Style>
</Window.Resources>
    
    <Border Background="{DynamicResource BgCard}" Margin="20" CornerRadius="12" Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <TextBlock Grid.Row="0" 
                       Text="🔧 代理配置" 
                       Foreground="{DynamicResource TextPrimary}"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Margin="0,0,0,24"/>
            
            <StackPanel Grid.Row="1">
                <TextBlock Text="代理 Worker URL" 
                           Foreground="{DynamicResource TextSecondary}"
                           FontSize="13"
                           Margin="0,0,0,8"/>
                <TextBox x:Name="ProxyUrlTextBox"
                         Style="{StaticResource DialogTextBox}"
                         Margin="0,0,0,20"/>
                
                <TextBlock Text="访问密钥（可选）" 
                           Foreground="{DynamicResource TextSecondary}"
                           FontSize="13"
                           Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <PasswordBox x:Name="ProxyKeyBox"
                                 Grid.Column="0"
                                 Style="{StaticResource DialogPasswordBox}"
                                 Margin="0,0,10,0"/>
                    <TextBox x:Name="ProxyKeyBoxVisible"
                             Grid.Column="0"
                             Style="{StaticResource DialogTextBox}"
                             Margin="0,0,10,0"
                             Visibility="Collapsed"/>
                    <Button x:Name="ToggleProxyKeyBtn"
                            Grid.Column="1"
                            Content="👁️"
                            Style="{StaticResource DialogSecondaryButton}"
                            HorizontalAlignment="Stretch"
                            Click="ToggleProxyKeyVisibility_Click"/>
                </Grid>
            </StackPanel>
            
            <StackPanel Grid.Row="2" 
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,24,0,0">
                <Button Content="取消"
                        Style="{StaticResource SecondaryButton}"
                        Margin="0,0,12,0"
                        Click="Cancel_Click"
                        IsCancel="True"/>
                <Button Content="保存"
                        Style="{StaticResource PrimaryButton}"
                        Click="Save_Click"
                        IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
